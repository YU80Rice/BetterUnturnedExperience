<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{4E2A7B6C-4AA2-4F84-B7C0-0B00000000A2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>BueLoadFileProbe</RootNamespace>
    <!-- DEV-V2-24 T7-4 C4' 修正仪器:标准 BepInEx 装载路径上 Mono LoadFrom 身份折叠使同名副本
         进不了 AppDomain(C4 finding);本探针走非标准装载通道(临时副本+Assembly.LoadFile,绕过
         身份绑定)在 BUE Awake 之前把第二个同名程序集实例注入 AppDomain,正向触发 BUE-PLATFORM-001
         ——即 SDK §8 补注所称 001 兜底的非标准路径,实机双证的实装。自身程序集名独立(不同名)。 -->
    <AssemblyName>BueLoadFileProbe</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>10.0</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <Optimize>true</Optimize><OutputPath>bin\lf\</OutputPath><DefineConstants>TRACE</DefineConstants><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="BepInEx"><HintPath>..\..\..\..\..\..\Libs\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>..\..\..\..\..\..\Libs\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>..\..\..\..\..\..\Libs\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="LoadFileProbe.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
